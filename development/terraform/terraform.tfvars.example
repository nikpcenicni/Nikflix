# Copy to terraform.tfvars (gitignored) and fill in.

proxmox_endpoint  = "https://192.168.10.10:8006/"
# Do not set proxmox_api_token here. Export it as an environment variable
# instead: TF_VAR_proxmox_api_token="terraform@pve!terraform=<uuid>". This
# keeps the token out of any file on disk. See README.md's Variables section.

# Leave these at their defaults unless your setup differs:
# talos_version           = "v1.13.7"
# talos_schematic_id      = "376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba"
# iso_storage             = "local"
# vm_storage              = "local-lvm"
# proxmox_bridge_mgmt     = "vmbr0"
# proxmox_bridge_storage  = "vmbr2"
# enable_storage_nic      = false
